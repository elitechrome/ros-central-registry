load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

HEADERS = glob([
    "include/**/*.h",
    "include/**/*.hpp",
])

SOURCES = [
    "src/json_serializer.cpp",
    "src/message_cleanup.cpp",
    "src/service_action_types.cpp",
    "src/type_cache.cpp",
    "src/type_introspection.cpp",
    "src/vendored/dynmsg/message_reading_cpp.cpp",
    "src/vendored/dynmsg/msg_parser_cpp.cpp",
    "src/vendored/dynmsg/string_utils.cpp",
    "src/vendored/dynmsg/typesupport.cpp",
    "src/vendored/dynmsg/vector_utils.cpp",
    "src/vendored/dynmsg/yaml_utils.cpp",
]

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rcpputils//:rcpputils": "@rcpputils//:rcpputils_library",
    "@rcutils//:rcutils": "@rcutils//:rcutils_library",
    "@rmw//:rmw": "@rmw//:rmw_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rosidl_runtime_c//:rosidl_runtime_c": "@rosidl_runtime_c//:rosidl_runtime_c_library",
    "@rosidl_runtime_cpp//:rosidl_runtime_cpp": "@rosidl_runtime_cpp//:rosidl_runtime_cpp_library",
    "@rosidl_typesupport_cpp//:rosidl_typesupport_cpp": "@rosidl_typesupport_cpp//:rosidl_typesupport_cpp_library",
    "@rosidl_typesupport_introspection_c//:rosidl_typesupport_introspection_c": "@rosidl_typesupport_introspection_c//:rosidl_typesupport_introspection_c_library",
    "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp": "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp_library",
}

cc_library(
    name = "ros2_medkit_serialization_library",
    srcs = SOURCES,
    hdrs = HEADERS,
    copts = ["-std=c++17"],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@nlohmann_json//:singleheader-json",
    ],
)

cc_shared_library(
    name = "ros2_medkit_serialization",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":ros2_medkit_serialization_library"],
    deps = [":ros2_medkit_serialization_library"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    libraries = [":ros2_medkit_serialization"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@rclcpp//:ament_package",
        "@rcpputils//:ament_package",
        "@rcutils//:ament_package",
        "@rmw//:ament_package",
        "@ros2_medkit_cmake//:ament_package",
        "@ros_workspace//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_runtime_c//:ament_package",
        "@rosidl_runtime_cpp//:ament_package",
        "@rosidl_typesupport_cpp//:ament_package",
        "@rosidl_typesupport_introspection_c//:ament_package",
        "@rosidl_typesupport_introspection_cpp//:ament_package",
        "@yaml_cpp_vendor//:ament_package",
    ],
)
