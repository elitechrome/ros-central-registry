load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

### LIBRARIES

HEADERS = glob(["include/**/*.h"])

cc_library(
    name = "mrpt_typemeta",
    hdrs = HEADERS,
    copts = ["-std=c++17"],
    includes = ["include"],
)

### TESTING

cc_test(
    name = "test_mrpt_typemeta",
    srcs = glob(["tests/*_unittest.cpp"]),
    deps = [
        ":mrpt_typemeta",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@mrpt_common//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
