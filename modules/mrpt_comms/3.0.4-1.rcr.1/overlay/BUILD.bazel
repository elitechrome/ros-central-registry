load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@cmake_configure_file//:cmake_configure_file.bzl", "cmake_configure_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

### PREPROCESSING

cmake_configure_file(
    name = "config_h",
    src = "config.h.in",
    out = "include/mrpt/comms/config.h",
    defines = [
        "CMAKE_MRPT_HAS_FTDI=0",
        "LIBFTDI_VERSION_MAJOR=0",
        "LIBFTDI_VERSION_MINOR=0",
    ],
)

### LIBRARIES

HEADERS = [
    ":config_h",
] + glob(["include/**/*.h"])

DEPENDENCIES = {
    "@mrpt_io//:mrpt_io": "@mrpt_io//:mrpt_io_library",
}

TRANSITIVE_DYNAMIC_DEPS = [
    "@mrpt_containers//:mrpt_containers",
    "@mrpt_core//:mrpt_core",
    "@mrpt_system//:mrpt_system",
    "@rosdistro//cc:zlib",
    "@rosdistro//cc:zstd",
]

cc_library(
    name = "mrpt_comms_library",
    srcs = [
        "src/CClientTCPSocket.cpp",
        "src/CInterfaceFTDI_common.cpp",
        "src/CInterfaceFTDI_LIN.cpp",
        "src/CInterfaceFTDI_WIN.cpp",
        "src/CSerialPort.cpp",
        "src/CServerTCPSocket.cpp",
        "src/CServerTCPSocket_common.cpp",
        "src/net_utils.cpp",
        "src/nodelets.cpp",
    ],
    hdrs = HEADERS,
    copts = ["-std=c++17"],
    includes = ["include"],
    linkopts = ["-pthread"],
    deps = DEPENDENCIES.values(),
)

cc_shared_library(
    name = "mrpt_comms",
    dynamic_deps = DEPENDENCIES.keys() + TRANSITIVE_DYNAMIC_DEPS,
    exports_filter = [":mrpt_comms_library"],
    deps = [":mrpt_comms_library"],
)

### PYTHON MODULES

cc_library(
    name = "mrpt_comms_py_bindings_library",
    srcs = ["python_bindings/mrpt_comms_py.cpp"],
    copts = ["-std=c++17"],
    includes = ["include"],
    visibility = ["//visibility:private"],
    deps = [
        ":mrpt_comms_library",
        "@rosdistro//cc:pybind11",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_shared_library(
    name = "mrpt_comms_py_bindings",
    dynamic_deps = [
        ":mrpt_comms",
    ] + DEPENDENCIES.keys() + TRANSITIVE_DYNAMIC_DEPS,
    exports_filter = [":mrpt_comms_py_bindings_library"],
    shared_lib_name = "mrpt/comms/_bindings.so",
    user_link_flags = select({
        "@platforms//os:osx": [
            "-undefined",
            "dynamic_lookup",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
    deps = [":mrpt_comms_py_bindings_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":mrpt_comms"],
    visibility = ["//visibility:private"],
)

py_library(
    name = "mrpt_comms_py",
    srcs = glob(["python/mrpt/**/*.py"]),
    data = [
        ":mrpt_comms",
        ":mrpt_comms_py_bindings",
        ":transitive_dynamic_deps",
    ],
    imports = ["python"],
    deps = [
        "@mrpt_io//:mrpt_io_py",
    ],
)

### TESTING

py_pytest(
    name = "test_python_comms",
    srcs = ["tests/python_comms_test.py"],
    deps = [
        ":mrpt_comms_py",
        "@rules_python//python/runfiles",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    libraries = [":mrpt_comms"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@mrpt_common//:ament_package",
        "@mrpt_io//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
