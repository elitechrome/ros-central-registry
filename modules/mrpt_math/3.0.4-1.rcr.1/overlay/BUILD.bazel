load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@cmake_configure_file//:cmake_configure_file.bzl", "cmake_configure_file")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

### PREPROCESSING

cmake_configure_file(
    name = "config_h",
    src = "config.h.in",
    out = "include/mrpt/math/config.h",
    defines = [
        "CMAKE_MRPT_HAS_NANOFLANN=1",
        "CMAKE_MRPT_HAS_NANOFLANN_SYSTEM=1",
    ],
)

### LIBRARIES

HEADERS = [
    ":config_h",
] + glob([
    "include/**/*.h",
    "include/**/*.hpp",
])

PRIVATE_HEADERS = [
    "src/CMatrixFixed_impl.h",
    "src/MatrixBase_impl.h",
    "src/MatrixVectorBase_impl.h",
    "src/polygons_utils.h",
]

cc_library(
    name = "mrpt_math_library",
    srcs = [
        "src/A_MatrixBase_instantiate_CMatrixDynamic_d.cpp",
        "src/A_MatrixBase_instantiate_CMatrixDynamic_f.cpp",
        "src/CAtan2LookUpTable.cpp",
        "src/CHistogram.cpp",
        "src/CMatrixB.cpp",
        "src/CMatrixD.cpp",
        "src/CMatrixDynamic.cpp",
        "src/CMatrixF.cpp",
        "src/CMatrixFixed.cpp",
        "src/CPolygon.cpp",
        "src/CSplineInterpolator1D.cpp",
        "src/CVectorDynamic.cpp",
        "src/CVectorFixed.cpp",
        "src/filters.cpp",
        "src/fourier.cpp",
        "src/fresnel.cpp",
        "src/geometry.cpp",
        "src/math.cpp",
        "src/MatrixBase_instantiate_CMatrixFixed_22_d.cpp",
        "src/MatrixBase_instantiate_CMatrixFixed_22_f.cpp",
        "src/MatrixBase_instantiate_CMatrixFixed_33_d.cpp",
        "src/MatrixBase_instantiate_CMatrixFixed_33_f.cpp",
        "src/MatrixVectorBase_instantiate_CMatrixDynamic_d.cpp",
        "src/MatrixVectorBase_instantiate_CMatrixDynamic_f.cpp",
        "src/MatrixVectorBase_instantiate_CMatrixDynamic_ints.cpp",
        "src/MatrixVectorBase_instantiate_CMatrixFixed.cpp",
        "src/MatrixVectorBase_instantiate_CVectorDynamic.cpp",
        "src/MatrixVectorBase_instantiate_CVectorFixed.cpp",
        "src/model_search.cpp",
        "src/poly_roots.cpp",
        "src/ransac_applications.cpp",
        "src/registerAllClasses.cpp",
        "src/S_MatrixBase_instantiate_CMatrixFixed_66_d.cpp",
        "src/S_MatrixBase_instantiate_CMatrixFixed_66_f.cpp",
        "src/S_MatrixBase_instantiate_CMatrixFixed_77_d.cpp",
        "src/slerp.cpp",
        "src/TBoundingBox.cpp",
        "src/TLine2D.cpp",
        "src/TLine3D.cpp",
        "src/TObject2D.cpp",
        "src/TObject3D.cpp",
        "src/TOrientedBox.cpp",
        "src/TPlane.cpp",
        "src/TPoint2D.cpp",
        "src/TPoint3D.cpp",
        "src/TPolygon2D.cpp",
        "src/TPolygon3D.cpp",
        "src/TPolygonWithPlane.cpp",
        "src/TPose2D.cpp",
        "src/TPose3D.cpp",
        "src/TPose3DQuat.cpp",
        "src/TSegment2D.cpp",
        "src/TSegment3D.cpp",
        "src/Twist2D.cpp",
        "src/Twist3D.cpp",
        "src/Z_MatrixBase_instantiate_CMatrixFixed_44_d.cpp",
        "src/Z_MatrixBase_instantiate_CMatrixFixed_44_f.cpp",
    ] + PRIVATE_HEADERS,
    hdrs = HEADERS,
    # Some explicit instantiation sources include CMatrixFixed only, while
    # MatrixBase methods in that path return CMatrixDynamic.
    copts = [
        "-std=c++17",
        "-include",
        "mrpt/math/CMatrixDynamic.h",
    ],
    includes = ["include"],
    deps = [
        "@eigen//:eigen",
        "@mrpt_containers//:mrpt_containers_library",
        "@mrpt_core//:mrpt_core_library",
        "@mrpt_random//:mrpt_random_library",
        "@mrpt_serialization//:mrpt_serialization_library",
        "@mrpt_system//:mrpt_system_library",
        "@nanoflann//:nanoflann",
    ],
)

cc_shared_library(
    name = "mrpt_math",
    dynamic_deps = [
        "@mrpt_containers//:mrpt_containers",
        "@mrpt_core//:mrpt_core",
        "@mrpt_random//:mrpt_random",
        "@mrpt_rtti//:mrpt_rtti",
        "@mrpt_serialization//:mrpt_serialization",
        "@mrpt_system//:mrpt_system",
    ],
    exports_filter = [":mrpt_math_library"],
    deps = [":mrpt_math_library"],
)

### PYTHON MODULES

cc_library(
    name = "mrpt_math_py_bindings_library",
    srcs = ["python_bindings/mrpt_math_py.cpp"],
    copts = ["-std=c++17"],
    includes = ["include"],
    visibility = ["//visibility:private"],
    deps = [
        ":mrpt_math_library",
        "@eigen//:eigen",
        "@rosdistro//cc:pybind11",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_shared_library(
    name = "mrpt_math_py_bindings",
    dynamic_deps = [
        ":mrpt_math",
        "@mrpt_containers//:mrpt_containers",
        "@mrpt_core//:mrpt_core",
        "@mrpt_random//:mrpt_random",
        "@mrpt_rtti//:mrpt_rtti",
        "@mrpt_serialization//:mrpt_serialization",
        "@mrpt_system//:mrpt_system",
    ],
    exports_filter = [":mrpt_math_py_bindings_library"],
    shared_lib_name = "mrpt/math/_bindings.so",
    user_link_flags = select({
        "@platforms//os:osx": [
            "-undefined",
            "dynamic_lookup",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
    deps = [":mrpt_math_py_bindings_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":mrpt_math"],
    visibility = ["//visibility:private"],
)

py_library(
    name = "mrpt_math_py",
    srcs = glob(["python/mrpt/**/*.py"]),
    data = [
        ":mrpt_math",
        ":mrpt_math_py_bindings",
        ":transitive_dynamic_deps",
    ],
    imports = ["python"],
    deps = [
        "@mrpt_rtti//:mrpt_rtti_py",
        "@mrpt_serialization//:mrpt_serialization_py",
        requirement("numpy"),
    ],
)

### TESTING

cc_test(
    name = "test_mrpt_math",
    srcs = glob(
        ["tests/*_unittest.cpp"],
        exclude = [
            "tests/CLevenbergMarquardt_unittest.cpp",
            "tests/TObject2D_unittest.cpp",
            "tests/TObject3D_unittest.cpp",
            "tests/TTwist3D_unittest.cpp",
        ],
    ),
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":mrpt_math_library",
        "@eigen//:eigen",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mrpt_common//:common_headers",
        "@nanoflann//:nanoflann",
    ],
)

py_pytest(
    name = "test_python_math",
    srcs = ["tests/python_math_test.py"],
    deps = [
        ":mrpt_math_py",
        "@rules_python//python/runfiles",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    libraries = [":mrpt_math"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@mrpt_common//:ament_package",
        "@mrpt_random//:ament_package",
        "@mrpt_serialization//:ament_package",
        "@mrpt_system//:ament_package",
        "@nanoflann//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
