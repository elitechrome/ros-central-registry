load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

### LIBRARIES

HEADERS = glob(["include/**/*.h"])

cc_library(
    name = "mrpt_rtti_library",
    srcs = [
        "src/CListOfClasses.cpp",
        "src/CObject.cpp",
        "src/internal_class_registry.cpp",
        "src/internal_class_registry.h",
    ],
    hdrs = HEADERS,
    copts = ["-std=c++17"],
    includes = ["include"],
    deps = [
        "@mrpt_core//:mrpt_core_library",
        "@mrpt_typemeta//:mrpt_typemeta",
    ],
)

cc_shared_library(
    name = "mrpt_rtti",
    dynamic_deps = ["@mrpt_core//:mrpt_core"],
    exports_filter = [":mrpt_rtti_library"],
    deps = [":mrpt_rtti_library"],
)

### PYTHON MODULES

cc_library(
    name = "mrpt_rtti_py_bindings_library",
    srcs = ["python_bindings/mrpt_rtti_py.cpp"],
    copts = ["-std=c++17"],
    includes = ["include"],
    visibility = ["//visibility:private"],
    deps = [
        ":mrpt_rtti_library",
        "@rosdistro//cc:pybind11",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_shared_library(
    name = "mrpt_rtti_py_bindings",
    dynamic_deps = [
        ":mrpt_rtti",
        "@mrpt_core//:mrpt_core",
    ],
    exports_filter = [":mrpt_rtti_py_bindings_library"],
    shared_lib_name = "mrpt/rtti/_bindings.so",
    user_link_flags = select({
        "@platforms//os:osx": [
            "-undefined",
            "dynamic_lookup",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
    deps = [":mrpt_rtti_py_bindings_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":mrpt_rtti"],
    visibility = ["//visibility:private"],
)

py_library(
    name = "mrpt_rtti_py",
    srcs = glob(["python/mrpt/**/*.py"]),
    data = [
        ":mrpt_rtti",
        ":mrpt_rtti_py_bindings",
        ":transitive_dynamic_deps",
    ],
    imports = ["python"],
)

### TESTING

cc_test(
    name = "test_mrpt_rtti",
    srcs = ["tests/rtti_unittest.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":mrpt_rtti_library",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

py_pytest(
    name = "test_python_rtti",
    srcs = ["tests/python_rtti_test.py"],
    deps = [
        ":mrpt_rtti_py",
        "@rules_python//python/runfiles",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    libraries = [":mrpt_rtti"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@mrpt_common//:ament_package",
        "@mrpt_core//:ament_package",
        "@mrpt_typemeta//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
