load("@rosidl_default_generators//:defs.bzl", "ros_service")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["*.srv"]))

ros_service(
    name = "ClearFault",
    src = "ClearFault.srv",
)

ros_service(
    name = "GetCapabilities",
    src = "GetCapabilities.srv",
)

ros_service(
    name = "GetEntityData",
    src = "GetEntityData.srv",
)

ros_service(
    name = "GetFault",
    src = "GetFault.srv",
    deps = [
        "//msg:EnvironmentData",
        "//msg:Fault",
    ],
)

ros_service(
    name = "GetRosbag",
    src = "GetRosbag.srv",
)

ros_service(
    name = "GetSnapshots",
    src = "GetSnapshots.srv",
)

ros_service(
    name = "ListEntities",
    src = "ListEntities.srv",
    deps = [
        "//msg:EntityInfo",
    ],
)

ros_service(
    name = "ListFaults",
    src = "ListFaults.srv",
    deps = [
        "//msg:ClusterInfo",
        "//msg:Fault",
        "//msg:MutedFaultInfo",
    ],
)

ros_service(
    name = "ListFaultsForEntity",
    src = "ListFaultsForEntity.srv",
    deps = [
        "//msg:Fault",
    ],
)

ros_service(
    name = "ListRosbags",
    src = "ListRosbags.srv",
)

ros_service(
    name = "ReportFault",
    src = "ReportFault.srv",
)
