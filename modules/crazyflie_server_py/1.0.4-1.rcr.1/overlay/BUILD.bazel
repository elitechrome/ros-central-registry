load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")

package(default_visibility = ["//visibility:public"])

ament_index(
    name = "ament_index",
    data = glob(["resource/**"]),
    package_xml = "package.xml",
)

py_library(
    name = "crazyflie_server_py",
    srcs = glob(["crazyflie_server_py/**/*.py"]),
    data = [":ament_index"],
    imports = ["."],
    deps = [
        "@crazyflie_interfaces//:py",
        "@geometry_msgs//:py",
        "@nav_msgs//:py",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        "@std_srvs//:py",
    ],
)

py_binary(
    name = "crazyflie_server",
    srcs = ["crazyflie_server_py/crazyflie_server.py"],
    deps = [":crazyflie_server_py"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        ":crazyflie_server",
        ":crazyflie_server_py",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@crazyflie_interfaces//:ament_package",
        "@geometry_msgs//:ament_package",
        "@motion_capture_tracking_interfaces//:ament_package",
        "@nav_msgs//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@tf2_ros//:ament_package",
    ],
)
