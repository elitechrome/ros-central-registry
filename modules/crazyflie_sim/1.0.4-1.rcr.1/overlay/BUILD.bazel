load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")

package(default_visibility = ["//visibility:public"])

ament_index(
    name = "ament_index",
    data = glob(["resource/**"]),
    package_xml = "package.xml",
)

py_library(
    name = "crazyflie_sim",
    srcs = glob(["crazyflie_sim/**/*.py"]),
    data = [":ament_index"],
    imports = ["."],
    deps = [
        requirement("numpy"),
        requirement("pyyaml"),
        "@crazyflie_interfaces//:py",
        "@geometry_msgs//:py",
        "@rclpy",
        "@rosgraph_msgs//:py",
        "@std_msgs//:py",
        "@std_srvs//:py",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        ":crazyflie_sim",
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@crazyflie_interfaces//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
