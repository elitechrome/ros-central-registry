load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

HEADERS = glob(["include/**/*.hpp"])

cc_library(
    name = "medkit_linux_utils",
    srcs = [
        "src/linux_utils/cgroup_reader.cpp",
        "src/linux_utils/proc_reader.cpp",
    ],
    hdrs = HEADERS,
    copts = ["-std=c++17"],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = [
        "@nlohmann_json//:singleheader-json",
        "@ros2_medkit_gateway//:gateway_library",
    ],
)

cc_library(
    name = "procfs_introspection_library",
    srcs = ["src/procfs_plugin.cpp"],
    hdrs = HEADERS,
    copts = ["-std=c++17"],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = [
        ":medkit_linux_utils",
        "@nlohmann_json//:singleheader-json",
        "@ros2_medkit_gateway//:gateway_library",
    ],
)

cc_shared_library(
    name = "procfs_introspection",
    exports_filter = [":procfs_introspection_library"],
    deps = [":procfs_introspection_library"],
)

cc_library(
    name = "container_introspection_library",
    srcs = ["src/container_plugin.cpp"],
    hdrs = HEADERS,
    copts = ["-std=c++17"],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = [
        ":medkit_linux_utils",
        "@nlohmann_json//:singleheader-json",
        "@ros2_medkit_gateway//:gateway_library",
    ],
)

cc_shared_library(
    name = "container_introspection",
    exports_filter = [":container_introspection_library"],
    deps = [":container_introspection_library"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    libraries = [
        ":container_introspection",
        ":procfs_introspection",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ros2_medkit_cmake//:ament_package",
        "@ros2_medkit_gateway//:ament_package",
        "@ros_workspace//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
