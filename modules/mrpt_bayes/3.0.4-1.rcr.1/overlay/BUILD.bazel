load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

### LIBRARIES

HEADERS = glob(["include/**/*.h"])

DEPENDENCIES = {
    "@mrpt_config//:mrpt_config": "@mrpt_config//:mrpt_config_library",
    "@mrpt_math//:mrpt_math": "@mrpt_math//:mrpt_math_library",
    "@mrpt_random//:mrpt_random": "@mrpt_random//:mrpt_random_library",
}

TRANSITIVE_DYNAMIC_DEPS = [
    "@mrpt_containers//:mrpt_containers",
    "@mrpt_core//:mrpt_core",
    "@mrpt_rtti//:mrpt_rtti",
    "@mrpt_serialization//:mrpt_serialization",
    "@mrpt_system//:mrpt_system",
]

cc_library(
    name = "mrpt_bayes_library",
    srcs = [
        "src/CParticleFilter.cpp",
        "src/CParticleFilterCapable.cpp",
    ],
    hdrs = HEADERS,
    copts = ["-std=c++17"],
    includes = ["include"],
    deps = [
        "@eigen//:eigen",
    ] + DEPENDENCIES.values(),
)

cc_shared_library(
    name = "mrpt_bayes",
    dynamic_deps = DEPENDENCIES.keys() + TRANSITIVE_DYNAMIC_DEPS,
    exports_filter = [":mrpt_bayes_library"],
    deps = [":mrpt_bayes_library"],
)

### PYTHON MODULES

cc_library(
    name = "mrpt_bayes_py_bindings_library",
    srcs = ["python_bindings/mrpt_bayes_py.cpp"],
    copts = ["-std=c++17"],
    includes = ["include"],
    visibility = ["//visibility:private"],
    deps = [
        ":mrpt_bayes_library",
        "@rosdistro//cc:pybind11",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_shared_library(
    name = "mrpt_bayes_py_bindings",
    dynamic_deps = [
        ":mrpt_bayes",
    ] + DEPENDENCIES.keys() + TRANSITIVE_DYNAMIC_DEPS,
    exports_filter = [":mrpt_bayes_py_bindings_library"],
    shared_lib_name = "mrpt/bayes/_bindings.so",
    user_link_flags = select({
        "@platforms//os:osx": [
            "-undefined",
            "dynamic_lookup",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
    deps = [":mrpt_bayes_py_bindings_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":mrpt_bayes"],
    visibility = ["//visibility:private"],
)

py_library(
    name = "mrpt_bayes_py",
    srcs = glob(["python/mrpt/**/*.py"]),
    data = [
        ":mrpt_bayes",
        ":mrpt_bayes_py_bindings",
        ":transitive_dynamic_deps",
    ],
    imports = ["python"],
)

### TESTING

cc_test(
    name = "test_mrpt_bayes",
    srcs = ["tests/bayes_unittest.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":mrpt_bayes_library",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

py_pytest(
    name = "test_python_bayes",
    srcs = ["tests/python_bayes_test.py"],
    deps = [
        ":mrpt_bayes_py",
        "@rules_python//python/runfiles",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    libraries = [":mrpt_bayes"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@mrpt_common//:ament_package",
        "@mrpt_config//:ament_package",
        "@mrpt_math//:ament_package",
        "@mrpt_random//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
