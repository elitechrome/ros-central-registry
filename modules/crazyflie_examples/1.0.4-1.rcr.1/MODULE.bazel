module(
    name = "crazyflie_examples",
    version = "1.0.4-1.rcr.1",
    bazel_compatibility = [">=7.2.1"],
)

# BCR dependencies
bazel_dep(name = "aspect_rules_py", version = "1.11.2")
bazel_dep(name = "rules_python", version = "1.9.0")

# RCR Dependencies
bazel_dep(name = "ament_cmake", version = "2.8.7-3.rcr.1")
bazel_dep(name = "ament_cmake_pytest", version = "2.8.7-3.rcr.1")
bazel_dep(name = "ament_cmake_python", version = "2.8.7-3.rcr.1")
bazel_dep(name = "ament_copyright", version = "0.20.6-1.rcr.1")
bazel_dep(name = "ament_flake8", version = "0.20.6-1.rcr.1")
bazel_dep(name = "ament_pep257", version = "0.20.6-1.rcr.1")
bazel_dep(name = "crazyflie_py", version = "1.0.4-1.rcr.1")
bazel_dep(name = "geometry_msgs", version = "5.9.2-3.rcr.1")
bazel_dep(name = "nav_msgs", version = "5.9.2-3.rcr.1")
bazel_dep(name = "rclpy", version = "10.0.10-1.rcr.1")
bazel_dep(name = "rosdistro", version = "lyrical.2026-06-08.rcr.1")
bazel_dep(name = "sensor_msgs", version = "5.9.2-3.rcr.1")
bazel_dep(name = "tf2_ros", version = "0.45.7-3.rcr.1")
bazel_dep(name = "tf_transformations", version = "1.1.1-3.rcr.1")

# Setup Python
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

# Setup Pip
pip_ros = use_extension("@rosdistro//python:defs.bzl", "pip_ros")
use_repo(pip_ros, "pip_ros")
