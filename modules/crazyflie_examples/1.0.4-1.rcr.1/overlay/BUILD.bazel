load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")

package(default_visibility = ["//visibility:public"])

PACKAGE_DATA = glob([
    "config/**",
    "data/**",
    "launch/**",
])

ament_index(
    name = "ament_index",
    data = glob(["resource/**"]) + PACKAGE_DATA,
    package_xml = "package.xml",
)

py_library(
    name = "crazyflie_examples",
    srcs = glob(["crazyflie_examples/**/*.py"]),
    data = [
        ":ament_index",
    ] + PACKAGE_DATA,
    imports = ["."],
    deps = [
        requirement("numpy"),
        "@crazyflie_py//:crazyflie_py",
        "@geometry_msgs//:py",
        "@nav_msgs//:py",
        "@rclpy",
        "@sensor_msgs//:py",
    ],
)

EXAMPLES = {
    "arming": "crazyflie_examples/arming.py",
    "cmd_full_state": "crazyflie_examples/cmd_full_state.py",
    "figure8": "crazyflie_examples/figure8.py",
    "goto_unicast": "crazyflie_examples/goto_unicast.py",
    "group_mask": "crazyflie_examples/group_mask.py",
    "hello_world": "crazyflie_examples/hello_world.py",
    "infinite_flight": "crazyflie_examples/infinite_flight.py",
    "multi_trajectory": "crazyflie_examples/multi_trajectory.py",
    "nice_hover": "crazyflie_examples/nice_hover.py",
    "set_param": "crazyflie_examples/set_param.py",
    "simple_mapper_multiranger": "crazyflie_examples/simple_mapper_multiranger.py",
    "swap": "crazyflie_examples/swap.py",
    "vel_mux": "crazyflie_examples/vel_mux.py",
}

[
    py_binary(
        name = name,
        srcs = [src],
        deps = [":crazyflie_examples"],
    )
    for name, src in EXAMPLES.items()
]

### PACKAGING

ament_package(
    name = "ament_package",
    data = PACKAGE_DATA,
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        ":crazyflie_examples",
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@crazyflie_py//:ament_package",
        "@geometry_msgs//:ament_package",
        "@nav_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@tf2_ros//:ament_package",
        "@tf_transformations//:ament_package",
    ] + [
        ":{}".format(name)
        for name in EXAMPLES
    ],
)
