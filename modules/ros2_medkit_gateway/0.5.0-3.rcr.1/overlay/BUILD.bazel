load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

HEADERS = glob([
    "include/**/*.h",
    "include/**/*.hpp",
    "src/openapi/**/*.hpp",
    "src/vendored/**/*.h",
    "src/vendored/**/*.hpp",
])

PACKAGE_DATA = glob([
    "config/**",
    "launch/**",
    "scripts/**",
])

DEPENDENCIES = [
    "@action_msgs//:cc",
    "@ament_index_cpp//:ament_index_cpp_library",
    "@nlohmann_json//:singleheader-json",
    "@rcl_interfaces//:cc",
    "@rclcpp//:rclcpp_library",
    "@ros2_medkit_msgs//:cc",
    "@ros2_medkit_serialization//:ros2_medkit_serialization_library",
    "@rosdistro//cc:sqlite3_library",
    "@rosdistro//cc:yaml-cpp_library",
    "@rosidl_typesupport_cpp//:rosidl_typesupport_cpp_library",
    "@rosidl_typesupport_introspection_cpp//:rosidl_typesupport_introspection_cpp_library",
    "@sensor_msgs//:cc",
    "@std_msgs//:cc",
    "@std_srvs//:cc",
    "@boringssl//:crypto",
    "@boringssl//:ssl",
]

cc_library(
    name = "gateway_library",
    srcs = glob(
        ["src/**/*.cpp"],
        exclude = ["src/main.cpp"],
    ),
    hdrs = HEADERS,
    copts = ["-std=c++17"],
    includes = [
        "include",
        "src/openapi",
        "src/vendored/cpp_httplib",
        "src/vendored/jwt_cpp/include",
        "src/vendored/mdns",
        "src/vendored/tl_expected/include",
    ],
    linkopts = ["-ldl"],
    local_defines = ros_local_defines() + [
        "CPPHTTPLIB_OPENSSL_SUPPORT",
        "GATEWAY_VERSION_STRING=\\\"0.5.0\\\"",
    ],
    deps = DEPENDENCIES,
)

cc_binary(
    name = "gateway_node",
    srcs = ["src/main.cpp"],
    linkopts = ["-Wl,--export-dynamic"],
    deps = [":gateway_library"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    data = PACKAGE_DATA,
    executables = [":gateway_node"],
    headers = HEADERS,
    package_xml = "package.xml",
    deps = [
        "@action_msgs//:ament_package",
        "@ament_cmake//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@ros2_medkit_cmake//:ament_package",
        "@ros2_medkit_msgs//:ament_package",
        "@ros2_medkit_serialization//:ament_package",
        "@ros_workspace//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_parser//:ament_package",
        "@rosidl_runtime_py//:ament_package",
        "@rosidl_typesupport_cpp//:ament_package",
        "@rosidl_typesupport_introspection_cpp//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@yaml_cpp_vendor//:ament_package",
    ],
)
