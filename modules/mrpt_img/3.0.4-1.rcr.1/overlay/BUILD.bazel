load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@cmake_configure_file//:cmake_configure_file.bzl", "cmake_configure_file")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

### PREPROCESSING

cmake_configure_file(
    name = "config_h",
    src = "config.h.in",
    out = "include/mrpt/img/config.h",
    defines = ["CMAKE_MRPT_HAS_ASIAN_FONTS=1"],
)

### LIBRARIES

HEADERS = [
    ":config_h",
] + glob(["include/**/*.h"])

PRIVATE_HEADERS = [
    "src/CImage_impl.h",
    "src/CImage.SSEx.h",
    "src/mrpt_font_10x20.h",
    "src/mrpt_font_18x18ja.h",
    "src/mrpt_font_5x7.h",
    "src/mrpt_font_6x13.h",
    "src/mrpt_font_6x13B.h",
    "src/mrpt_font_6x13O.h",
    "src/mrpt_font_9x15.h",
    "src/mrpt_font_9x15B.h",
    "src/remap_bilinear.h",
] + glob(["src/stb/*.h"])

DEPENDENCIES = {
    "@mrpt_config//:mrpt_config": "@mrpt_config//:mrpt_config_library",
    "@mrpt_io//:mrpt_io": "@mrpt_io//:mrpt_io_library",
    "@mrpt_math//:mrpt_math": "@mrpt_math//:mrpt_math_library",
    "@mrpt_serialization//:mrpt_serialization": "@mrpt_serialization//:mrpt_serialization_library",
}

TRANSITIVE_DYNAMIC_DEPS = [
    "@mrpt_containers//:mrpt_containers",
    "@mrpt_core//:mrpt_core",
    "@mrpt_expr//:mrpt_expr",
    "@mrpt_random//:mrpt_random",
    "@mrpt_rtti//:mrpt_rtti",
    "@mrpt_system//:mrpt_system",
    "@rosdistro//cc:zlib",
    "@rosdistro//cc:zstd",
]

cc_library(
    name = "mrpt_img_library",
    srcs = [
        "src/camera_geometry.cpp",
        "src/CCanvas.cpp",
        "src/CImage.cpp",
        "src/CImage_impl.cpp",
        "src/CImage_loadXPM.cpp",
        "src/CImagePyramid.cpp",
        "src/CImage.SSE2.cpp",
        "src/CImage.SSSE3.cpp",
        "src/CMappedImage.cpp",
        "src/color_maps.cpp",
        "src/CStereoRectifyMap.cpp",
        "src/CUndistortMap.cpp",
        "src/CVideoFileWriter.cpp",
        "src/registerAllClasses.cpp",
        "src/TCamera.cpp",
        "src/TColor.cpp",
        "src/TPixelCoord.cpp",
        "src/TStereoCamera.cpp",
    ] + PRIVATE_HEADERS,
    hdrs = HEADERS,
    copts = ["-std=c++17"],
    includes = [
        "include",
        "src",
    ],
    deps = [
        "@eigen//:eigen",
    ] + DEPENDENCIES.values(),
)

cc_shared_library(
    name = "mrpt_img",
    dynamic_deps = DEPENDENCIES.keys() + TRANSITIVE_DYNAMIC_DEPS,
    exports_filter = [":mrpt_img_library"],
    deps = [":mrpt_img_library"],
)

### PYTHON MODULES

cc_library(
    name = "mrpt_img_py_bindings_library",
    srcs = ["python_bindings/mrpt_img_py.cpp"],
    copts = ["-std=c++17"],
    includes = ["include"],
    visibility = ["//visibility:private"],
    deps = [
        ":mrpt_img_library",
        "@rosdistro//cc:pybind11",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_shared_library(
    name = "mrpt_img_py_bindings",
    dynamic_deps = [
        ":mrpt_img",
    ] + DEPENDENCIES.keys() + TRANSITIVE_DYNAMIC_DEPS,
    exports_filter = [":mrpt_img_py_bindings_library"],
    shared_lib_name = "mrpt/img/_bindings.so",
    user_link_flags = select({
        "@platforms//os:osx": [
            "-undefined",
            "dynamic_lookup",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
    deps = [":mrpt_img_py_bindings_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":mrpt_img"],
    visibility = ["//visibility:private"],
)

py_library(
    name = "mrpt_img_py",
    srcs = glob(["python/mrpt/**/*.py"]),
    data = [
        ":mrpt_img",
        ":mrpt_img_py_bindings",
        ":transitive_dynamic_deps",
    ],
    imports = ["python"],
    deps = [
        "@mrpt_rtti//:mrpt_rtti_py",
        "@mrpt_serialization//:mrpt_serialization_py",
        requirement("numpy"),
    ],
)

### TESTING

cc_test(
    name = "test_mrpt_img",
    srcs = [
        "tests/camera_geometry_unittest.cpp",
        "tests/color_maps_unittest.cpp",
        "tests/TCamera_unittest.cpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":mrpt_img_library",
        "@eigen//:eigen",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mrpt_common//:common_headers",
    ],
)

py_pytest(
    name = "test_python_img",
    srcs = ["tests/python_img_test.py"],
    deps = [
        ":mrpt_img_py",
        "@rules_python//python/runfiles",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    libraries = [":mrpt_img"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@mrpt_common//:ament_package",
        "@mrpt_config//:ament_package",
        "@mrpt_io//:ament_package",
        "@mrpt_math//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
