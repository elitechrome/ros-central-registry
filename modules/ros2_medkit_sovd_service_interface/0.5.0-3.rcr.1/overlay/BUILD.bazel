load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

HEADERS = glob(["src/**/*.hpp"])

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

cc_library(
    name = "sovd_service_interface_library",
    srcs = [
        "src/service_exports.cpp",
        "src/sovd_service_interface.cpp",
    ],
    hdrs = HEADERS,
    copts = ["-std=c++17"],
    includes = ["src"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@nlohmann_json//:singleheader-json",
        "@ros2_medkit_gateway//:gateway_library",
        "@ros2_medkit_msgs//:cc",
    ],
)

cc_shared_library(
    name = "sovd_service_interface",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":sovd_service_interface_library"],
    deps = [":sovd_service_interface_library"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    libraries = [":sovd_service_interface"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@rclcpp//:ament_package",
        "@ros2_medkit_cmake//:ament_package",
        "@ros2_medkit_gateway//:ament_package",
        "@ros2_medkit_msgs//:ament_package",
        "@ros_workspace//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
