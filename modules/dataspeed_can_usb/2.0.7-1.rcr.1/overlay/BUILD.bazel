load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

HEADERS = glob(["include/**/*.hpp"])

PACKAGE_DATA = glob([
    "firmware/**",
    "launch/**",
    "scripts/**",
    "udev/**",
])

DEPENDENCIES = {
    "@lusb//:lusb": "@lusb//:lusb_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
}

cc_library(
    name = "dataspeed_can_usb_library",
    srcs = [
        "src/CanDriver.cpp",
        "src/CanUsb.cpp",
        "src/UsbCanMessages.h",
    ],
    hdrs = HEADERS,
    copts = ["-std=c++20"],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@can_msgs//:cc",
        "@std_msgs//:cc",
    ],
)

cc_shared_library(
    name = "dataspeed_can_usb",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":dataspeed_can_usb_library"],
    deps = [":dataspeed_can_usb_library"],
)

### COMPONENTS

rclcpp_components_register_node(
    name = "can_node",
    component = ":dataspeed_can_usb",
    executor = "SingleThreadedExecutor",
    node_name = "can_node",
    plugin = "dataspeed_can_usb::CanDriver",
)

### PACKAGING

ament_package(
    name = "ament_package",
    data = PACKAGE_DATA,
    headers = HEADERS,
    libraries = [":dataspeed_can_usb"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@can_msgs//:ament_package",
        "@lusb//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@ros_workspace//:ament_package",
        "@rosdistro//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
