load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package", "register_ament_files")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")
load("@rules_qt//:qt.bzl", "qt_cc_library", "qt_cc_test")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

ament_index(
    name = "ament_index",
)

### LIBRARIES

DEPENDENCIES = {
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@interactive_markers//:interactive_markers": "@interactive_markers//:interactive_markers_library",
    "@laser_geometry//:laser_geometry": "@laser_geometry//:laser_geometry_library",
    "@point_cloud_transport//:point_cloud_transport": "@point_cloud_transport//:point_cloud_transport_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@resource_retriever_service_plugin//:resource_retriever_service_plugin": "@resource_retriever_service_plugin//:resource_retriever_service_plugin_library",
    "@resource_retriever//:resource_retriever": "@resource_retriever//:resource_retriever_library",
    "@rosdistro//cc:OgreMain": "@rosdistro//cc:OgreMain_library",
    "@rosdistro//cc:OgreOverlay": "@rosdistro//cc:OgreOverlay_library",
    "@rosdistro//cc:qt_abi_shim": "@rosdistro//cc:qt_abi_shim_library",
    "@rviz_common//:rviz_common": "@rviz_common//:rviz_common_library",
    "@rviz_rendering//:rviz_rendering": "@rviz_rendering//:rviz_rendering_library",
    "@tf2_geometry_msgs//:tf2_geometry_msgs": "@tf2_geometry_msgs//:tf2_geometry_msgs_library",
    "@tf2_ros//:tf2_ros": "@tf2_ros//:tf2_ros_library",
    "@tf2//:tf2": "@tf2//:tf2_library",
    "@urdf//:urdf": "@urdf//:urdf_library",
}

# qt_cc_library runs moc over hdrs: the display/tool/view controller headers
# declare Q_OBJECT classes.
qt_cc_library(
    name = "rviz_default_plugins_library",
    srcs = glob(
        [
            "src/**/*.cpp",
            "src/**/*.hpp",
            "src/**/*.h",
        ],
        allow_empty = True,
    ),
    hdrs = glob(
        [
            "include/**/*.hpp",
            "include/**/*.h",
        ],
        allow_empty = True,
    ),
    includes = ["include"],
    local_defines = ros_local_defines() + ["RVIZ_DEFAULT_PLUGINS_BUILDING_LIBRARY"],
    deps = DEPENDENCIES.values() + [
        "@geometry_msgs//:cc",
        "@map_msgs//:cc",
        "@nav_msgs//:cc",
        "@rosdistro//cc:gz_math",
        "@rules_qt//:qt_widgets",
        "@visualization_msgs//:cc",
    ],
)

cc_shared_library(
    name = "rviz_default_plugins",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":rviz_default_plugins_library"],
    deps = [":rviz_default_plugins_library"],
)

### TESTS

# Ports the unit tests from upstream's CMakeLists.txt. The *_visual_test
# targets are not ported: upstream only builds them with EnableVisualTests=True,
# since they render scenes and compare them against reference images
# (rviz_visual_testing_framework).

TEST_DEPENDENCIES = DEPENDENCIES | {
    ":rviz_default_plugins": ":rviz_default_plugins_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_test",
    dynamic_deps = TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

# Upstream installs these into share/rviz_default_plugins for its tests.
register_ament_files(
    name = "test_meshes",
    package_name = "rviz_default_plugins",
    files = glob(["test/ogre_media_resources/test_meshes/**"]),
    strip_prefix = "test/ogre_media_resources",
)

cc_library(
    name = "test_fixture_library",
    testonly = True,
    srcs = [
        "test/rviz_default_plugins/displays/display_test_fixture.cpp",
        "test/rviz_default_plugins/displays/marker/marker_messages.cpp",
        "test/rviz_default_plugins/ogre_testing_environment.cpp",
        "test/rviz_default_plugins/pointcloud_messages.cpp",
        "test/rviz_default_plugins/scene_graph_introspection.cpp",
    ],
    hdrs = glob(["test/rviz_default_plugins/**/*.hpp"]),
    includes = [
        "src",
        "test",
    ],
    local_defines = ros_local_defines(),
    deps = TEST_DEPENDENCIES.values() + [
        "@geometry_msgs//:cc",
        "@rosdistro//cc:googletest",
        "@rules_qt//:qt_widgets",
        "@visualization_msgs//:cc",
    ],
)

