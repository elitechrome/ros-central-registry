[
    qt_cc_test(
        name = name,
        srcs = ["test/rviz_default_plugins/" + src for src in srcs],
        data = [
            ":ament_index",
            ":test_meshes",
            # Loaded through pluginlib when the displays are created.
            "@image_transport//:ament_index_package",
            "@image_transport//:ament_index_plugin",
            "@point_cloud_transport//:ament_index_package",
            "@point_cloud_transport//:ament_index_plugin",
            "@rviz_common//:ament_index",
            "@rviz_rendering//:ament_index",
            "@rviz_rendering_tests//:ament_package",
            "@rviz_rendering_tests//:test_meshes",
            # The URDF parser plugin, loaded by the robot model.
            "@urdf//:ament_index",
            "@urdf//:ament_index_urdf",
        ],
        dynamic_deps = [":transitive_dynamic_deps_test"],
        env_inherit = [
            "DISPLAY",
            "QT_QPA_PLATFORM",
        ],
        includes = [
            "src",
            "test",
        ],
        local_defines = ros_local_defines(),
        tags = ["no-sandbox"],
        deps = TEST_DEPENDENCIES.values() + [
            ":test_fixture_library",
            "@geometry_msgs//:cc",
            "@rosdistro//cc:googletest",
            "@rules_qt//:qt_widgets",
            "@visualization_msgs//:cc",
        ],
    )
    for name, srcs in TESTS.items()
]

