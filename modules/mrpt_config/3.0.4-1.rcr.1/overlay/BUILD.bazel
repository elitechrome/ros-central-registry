load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@cmake_configure_file//:cmake_configure_file.bzl", "cmake_configure_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

### PREPROCESSING

cmake_configure_file(
    name = "config_h",
    src = "config.h.in",
    out = "include/mrpt/config/config.h",
    defines = [
        "CMAKE_MRPT_HAS_SIMPLEINI=1",
        "CMAKE_MRPT_HAS_SIMPLEINI_SYSTEM=0",
    ],
)

### LIBRARIES

HEADERS = [
    ":config_h",
] + glob(["include/**/*.h"])

SIMPLEINI_HEADERS = glob(["3rdparty/simpleini/*.h"])

cc_library(
    name = "simpleini",
    srcs = ["3rdparty/simpleini/ConvertUTF.c"],
    hdrs = SIMPLEINI_HEADERS,
    copts = ["-std=c11"],
    includes = ["3rdparty/simpleini"],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "mrpt_config_library",
    srcs = [
        "src/CConfigFile.cpp",
        "src/CConfigFileBase.cpp",
        "src/CConfigFileMemory.cpp",
        "src/CConfigFilePrefixer.cpp",
        "src/CLoadableOptions.cpp",
        "src/config_parser.cpp",
    ],
    hdrs = HEADERS,
    copts = ["-std=c++17"],
    includes = [
        "3rdparty/simpleini",
        "include",
    ],
    deps = [
        ":simpleini",
        "@mrpt_containers//:mrpt_containers_library",
        "@mrpt_expr//:mrpt_expr_library",
    ],
)

cc_shared_library(
    name = "mrpt_config",
    dynamic_deps = [
        "@mrpt_containers//:mrpt_containers",
        "@mrpt_core//:mrpt_core",
        "@mrpt_expr//:mrpt_expr",
        "@mrpt_system//:mrpt_system",
    ],
    exports_filter = [":mrpt_config_library"],
    deps = [":mrpt_config_library"],
)

### PYTHON MODULES

cc_library(
    name = "mrpt_config_py_bindings_library",
    srcs = ["python_bindings/mrpt_config_py.cpp"],
    copts = ["-std=c++17"],
    includes = ["include"],
    visibility = ["//visibility:private"],
    deps = [
        ":mrpt_config_library",
        "@rosdistro//cc:pybind11",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_shared_library(
    name = "mrpt_config_py_bindings",
    dynamic_deps = [
        ":mrpt_config",
        "@mrpt_containers//:mrpt_containers",
        "@mrpt_core//:mrpt_core",
        "@mrpt_expr//:mrpt_expr",
        "@mrpt_system//:mrpt_system",
    ],
    exports_filter = [":mrpt_config_py_bindings_library"],
    shared_lib_name = "mrpt/config/_bindings.so",
    user_link_flags = select({
        "@platforms//os:osx": [
            "-undefined",
            "dynamic_lookup",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
    deps = [":mrpt_config_py_bindings_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":mrpt_config"],
    visibility = ["//visibility:private"],
)

py_library(
    name = "mrpt_config_py",
    srcs = glob(["python/mrpt/**/*.py"]),
    data = [
        ":mrpt_config",
        ":mrpt_config_py_bindings",
        ":transitive_dynamic_deps",
    ],
    imports = ["python"],
)

### TESTING

cc_test(
    name = "test_mrpt_config",
    srcs = glob(["tests/*_unittest.cpp"]),
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":mrpt_config_library",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

py_pytest(
    name = "test_python_config",
    srcs = ["tests/python_config_test.py"],
    deps = [
        ":mrpt_config_py",
        "@rules_python//python/runfiles",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    libraries = [":mrpt_config"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@mrpt_common//:ament_package",
        "@mrpt_expr//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
