load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

### LIBRARIES

HEADERS = glob(["include/**/*.h"])

DEPENDENCIES = {
    "@mrpt_bayes//:mrpt_bayes": "@mrpt_bayes//:mrpt_bayes_library",
    "@mrpt_io//:mrpt_io": "@mrpt_io//:mrpt_io_library",
    "@mrpt_math//:mrpt_math": "@mrpt_math//:mrpt_math_library",
    "@mrpt_serialization//:mrpt_serialization": "@mrpt_serialization//:mrpt_serialization_library",
}

TRANSITIVE_DYNAMIC_DEPS = [
    "@mrpt_config//:mrpt_config",
    "@mrpt_containers//:mrpt_containers",
    "@mrpt_core//:mrpt_core",
    "@mrpt_expr//:mrpt_expr",
    "@mrpt_random//:mrpt_random",
    "@mrpt_rtti//:mrpt_rtti",
    "@mrpt_system//:mrpt_system",
    "@rosdistro//cc:zlib",
    "@rosdistro//cc:zstd",
]

cc_library(
    name = "mrpt_poses_library",
    srcs = [
        "src/CPoint.cpp",
        "src/CPoint2D.cpp",
        "src/CPoint2DPDF.cpp",
        "src/CPoint2DPDFGaussian.cpp",
        "src/CPoint3D.cpp",
        "src/CPointPDF.cpp",
        "src/CPointPDFGaussian.cpp",
        "src/CPointPDFParticles.cpp",
        "src/CPointPDFSOG.cpp",
        "src/CPose2D.cpp",
        "src/CPose2DInterpolator.cpp",
        "src/CPose3D.cpp",
        "src/CPose3DInterpolator.cpp",
        "src/CPose3DPDF.cpp",
        "src/CPose3DPDFGaussian.cpp",
        "src/CPose3DPDFGaussianInf.cpp",
        "src/CPose3DPDFGrid.cpp",
        "src/CPose3DPDFParticles.cpp",
        "src/CPose3DPDFSOG.cpp",
        "src/CPose3DQuat.cpp",
        "src/CPose3DQuatPDF.cpp",
        "src/CPose3DQuatPDFGaussian.cpp",
        "src/CPose3DQuatPDFGaussianInf.cpp",
        "src/CPoseInterpolatorBase.hpp",
        "src/CPosePDF.cpp",
        "src/CPosePDFGaussian.cpp",
        "src/CPosePDFGaussianInf.cpp",
        "src/CPosePDFGrid.cpp",
        "src/CPosePDFParticles.cpp",
        "src/CPosePDFSOG.cpp",
        "src/CPoseRandomSampler.cpp",
        "src/CPoses2DSequence.cpp",
        "src/CPoses3DSequence.cpp",
        "src/CRobot2DPoseEstimator.cpp",
        "src/FrameTransformer.cpp",
        "src/Lie/SE.cpp",
        "src/Lie/SO.cpp",
        "src/registerAllClasses.cpp",
        "src/sensor_poses.cpp",
        "src/SO_SE_average.cpp",
    ],
    hdrs = HEADERS,
    copts = ["-std=c++17"],
    includes = ["include"],
    deps = [
        "@eigen//:eigen",
    ] + DEPENDENCIES.values(),
)

cc_shared_library(
    name = "mrpt_poses",
    dynamic_deps = DEPENDENCIES.keys() + TRANSITIVE_DYNAMIC_DEPS,
    exports_filter = [":mrpt_poses_library"],
    deps = [":mrpt_poses_library"],
)

### PYTHON MODULES

cc_library(
    name = "mrpt_poses_py_bindings_library",
    srcs = ["python_bindings/mrpt_poses_py.cpp"],
    copts = ["-std=c++17"],
    includes = ["include"],
    visibility = ["//visibility:private"],
    deps = [
        ":mrpt_poses_library",
        "@rosdistro//cc:pybind11",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_shared_library(
    name = "mrpt_poses_py_bindings",
    dynamic_deps = [
        ":mrpt_poses",
    ] + DEPENDENCIES.keys() + TRANSITIVE_DYNAMIC_DEPS,
    exports_filter = [":mrpt_poses_py_bindings_library"],
    shared_lib_name = "mrpt/poses/_bindings.so",
    user_link_flags = select({
        "@platforms//os:osx": [
            "-undefined",
            "dynamic_lookup",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
    deps = [":mrpt_poses_py_bindings_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":mrpt_poses"],
    visibility = ["//visibility:private"],
)

py_library(
    name = "mrpt_poses_py",
    srcs = glob(["python/mrpt/**/*.py"]),
    data = [
        ":mrpt_poses",
        ":mrpt_poses_py_bindings",
        ":transitive_dynamic_deps",
    ],
    imports = ["python"],
    deps = [
        "@mrpt_math//:mrpt_math_py",
        "@mrpt_rtti//:mrpt_rtti_py",
        "@mrpt_serialization//:mrpt_serialization_py",
    ],
)

### TESTING

cc_test(
    name = "test_mrpt_poses",
    srcs = [
        "tests/CPoint2DPDF_unittest.cpp",
        "tests/CPoint_unittest.cpp",
        "tests/CPose2DInterpolator_unittest.cpp",
        "tests/CPose3D_unittest.cpp",
        "tests/CPose3DInterpolator_unittest.cpp",
        "tests/CPose3DPDFGaussian_unittest.cpp",
        "tests/CPose3DPDFGrid_unittest.cpp",
        "tests/CPose3DQuat_unittest.cpp",
        "tests/CPose3DQuatPDFGaussian_unittest.cpp",
        "tests/CPosePDFGaussian_unittest.cpp",
        "tests/CPosePDFGrid_unittest.cpp",
        "tests/CPoseRandomSampler_unittest.cpp",
        "tests/CQuaternion_unittest.cpp",
        "tests/CRobot2DPoseEstimator_unittest.cpp",
        "tests/CSchemeArchive_unittest.cpp",
        "tests/FrameTransformer_unittest.cpp",
        "tests/Lie_unittest.cpp",
        "tests/matrix_serialization_unittest.cpp",
        "tests/PosePDF_implementations_unittest.cpp",
        "tests/sensor_poses_unittest.cpp",
        "tests/SO_SE_average_unittest.cpp",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":mrpt_poses_library",
        "@eigen//:eigen",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@mrpt_common//:common_headers",
        "@mrpt_io//:mrpt_io_library",
    ],
)

py_pytest(
    name = "test_python_poses",
    srcs = ["tests/python_poses_test.py"],
    deps = [
        ":mrpt_poses_py",
        "@rules_python//python/runfiles",
        requirement("numpy"),
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    libraries = [":mrpt_poses"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@mrpt_bayes//:ament_package",
        "@mrpt_common//:ament_package",
        "@mrpt_io//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
