load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@cmake_configure_file//:cmake_configure_file.bzl", "cmake_configure_file")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

### PREPROCESSING

cmake_configure_file(
    name = "config_h",
    src = "config.h.in",
    out = "include/mrpt/core/config.h",
    defines = [
        "CMAKE_MRPT_BUILD_SHARED_LIB=#define MRPT_BUILT_AS_DLL",
        "CMAKE_MRPT_HAS_TBB=0",
        "EIGEN_MAX_ALIGN_BYTES=16",
        "EIGEN_MAX_STATIC_ALIGN_BYTES=16",
        "MRPT_ARCH_INTEL_COMPATIBLE=0",
        "CMAKE_MRPT_WORD_SIZE=64",
        "CMAKE_MRPT_HAS_SSE2=0",
        "CMAKE_MRPT_HAS_SSE3=0",
        "CMAKE_MRPT_HAS_SSE4_1=0",
        "CMAKE_MRPT_HAS_SSE4_2=0",
        "CMAKE_MRPT_HAS_SSE4_A=0",
        "CMAKE_MRPT_HAS_AVX=0",
        "CMAKE_MRPT_HAS_AVX2=0",
        "CMAKE_MRPT_HAS_NEON=0",
        "CMAKE_MRPT_IS_BIG_ENDIAN=0",
        "CMAKE_MRPT_IN_EMSCRIPTEN=0",
        "HAVE_LINUX_SERIAL_H=1",
        "HAVE_LINUX_INPUT_H=1",
        "HAVE_SYS_TIME_H=1",
        "HAVE_PTHREAD_H=1",
        "HAVE_UNISTD_H=1",
        "HAVE_MALLOC_H=1",
        "HAVE_TIMEGM=1",
        "HAVE_GETTID=1",
        "HAVE_SINCOS=1",
        "HAVE_STRTOK_R=1",
        "HAVE_LOCALTIME_R=1",
        "HAVE_LONG_DOUBLE=1",
        "CMAKE_MRPT_HAS_BFD=0",
    ],
)

cmake_configure_file(
    name = "version_h",
    src = "version.h.in",
    out = "include/mrpt/version.h",
    defines = [
        "CMAKE_MRPT_COMPLETE_NAME=MRPT 3.0.4",
        "CMAKE_MRPT_VERSION_CODE=0x030004",
        "CMAKE_SOURCE_DATE_EPOCH=",
        "mrpt_core_SOURCE_DIR=",
        "CMAKE_INSTALL_PREFIX=",
    ],
)

### LIBRARIES

HEADERS = [
    ":config_h",
    ":version_h",
] + glob(["include/**/*.h"])

cc_library(
    name = "mrpt_core_library",
    srcs = glob(["src/*.cpp"]),
    hdrs = HEADERS,
    copts = ["-std=c++17"],
    includes = ["include"],
    linkopts = select({
        "@platforms//os:linux": [
            "-ldl",
            "-pthread",
        ],
        "//conditions:default": [],
    }),
    local_defines = ["MRPT_EXCEPTIONS_CALL_STACK_MAX_DEPTH=50U"],
)

cc_shared_library(
    name = "mrpt_core",
    exports_filter = [":mrpt_core_library"],
    deps = [":mrpt_core_library"],
)

### PYTHON MODULES

cc_library(
    name = "mrpt_core_py_bindings_library",
    srcs = ["python_bindings/mrpt_core_py.cpp"],
    copts = ["-std=c++17"],
    includes = ["include"],
    visibility = ["//visibility:private"],
    deps = [
        ":mrpt_core_library",
        "@rosdistro//cc:pybind11",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_shared_library(
    name = "mrpt_core_py_bindings",
    dynamic_deps = [":mrpt_core"],
    exports_filter = [":mrpt_core_py_bindings_library"],
    shared_lib_name = "mrpt/core/_bindings.so",
    user_link_flags = select({
        "@platforms//os:osx": [
            "-undefined",
            "dynamic_lookup",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
    deps = [":mrpt_core_py_bindings_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":mrpt_core"],
    visibility = ["//visibility:private"],
)

py_library(
    name = "mrpt_core_py",
    srcs = glob(["python/mrpt/**/*.py"]),
    data = [
        ":mrpt_core",
        ":mrpt_core_py_bindings",
    ],
    imports = ["python"],
)

### TESTING

cc_test(
    name = "test_mrpt_core",
    srcs = glob(["tests/*_unittest.cpp"]),
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":mrpt_core_library",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

py_pytest(
    name = "test_python_core",
    srcs = ["tests/python_core_test.py"],
    deps = [
        ":mrpt_core_py",
        "@rules_python//python/runfiles",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    libraries = [":mrpt_core"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@mrpt_common//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
