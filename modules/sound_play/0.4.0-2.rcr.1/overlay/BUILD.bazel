load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")

package(default_visibility = ["//visibility:public"])

PACKAGE_DATA = glob([
    "launch/**",
    "sounds/**",
])

ament_index(
    name = "ament_index",
    package_xml = "package.xml",
    data = PACKAGE_DATA,
)

py_library(
    name = "sound_play",
    srcs = glob(["sound_play/**/*.py"]),
    data = [
        ":ament_index",
    ],
    imports = ["."],
    deps = [
        "@action_msgs//:py",
        "@ament_index_python",
        "@diagnostic_msgs//:py",
        "@rclpy",
        "@sound_play_msgs//:py",
        "@std_msgs//:py",
    ],
)

SCRIPTS = {
    "is_speaking": "scripts/is_speaking.py",
    "play": "scripts/play.py",
    "playbuiltin": "scripts/playbuiltin.py",
    "say": "scripts/say.py",
    "shutup": "scripts/shutup.py",
    "soundplay_node": "scripts/soundplay_node.py",
}

[
    py_binary(
        name = name,
        srcs = [src],
        main = src,
        deps = [":sound_play"],
    )
    for name, src in SCRIPTS.items()
]

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    data = PACKAGE_DATA,
    deps = [
        ":ament_index",
        ":sound_play",
        "@action_msgs//:ament_package",
        "@ament_cmake//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_index_python//:ament_package",
        "@diagnostic_msgs//:ament_package",
        "@launch_xml//:ament_package",
        "@rclpy//:ament_package",
        "@ros_workspace//:ament_package",
        "@rosdistro//:ament_package",
        "@sound_play_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ] + [
        ":{}".format(name)
        for name in SCRIPTS
    ],
)
