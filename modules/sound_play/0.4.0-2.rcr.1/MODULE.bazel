# ROS package information
module(
    name = "sound_play",
    version = "0.4.0-2.rcr.1",
    bazel_compatibility = [">=7.2.1"],
)

# BCR dependencies
bazel_dep(name = "aspect_rules_py", version = "1.11.2")
bazel_dep(name = "rules_python", version = "1.9.0")

# RCR Dependencies
bazel_dep(name = "action_msgs", version = "2.4.5-1.rcr.1")
bazel_dep(name = "ament_cmake", version = "2.8.7-3.rcr.1")
bazel_dep(name = "ament_cmake_python", version = "2.8.7-3.rcr.1")
bazel_dep(name = "ament_index_python", version = "1.13.3-3.rcr.1")
bazel_dep(name = "diagnostic_msgs", version = "5.9.2-3.rcr.1")
bazel_dep(name = "launch_xml", version = "3.9.7-3.rcr.1")
bazel_dep(name = "rclpy", version = "10.0.10-1.rcr.1")
bazel_dep(name = "ros_workspace", version = "1.0.3-9.rcr.1")
bazel_dep(name = "rosdistro", version = "lyrical.2026-06-08.rcr.1")
bazel_dep(name = "sound_play_msgs", version = "0.4.0-2.rcr.1")
bazel_dep(name = "std_msgs", version = "5.9.2-3.rcr.1")

# Setup Python
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

# Setup Pip
pip_ros = use_extension("@rosdistro//python:defs.bzl", "pip_ros")
use_repo(pip_ros, "pip_ros")
