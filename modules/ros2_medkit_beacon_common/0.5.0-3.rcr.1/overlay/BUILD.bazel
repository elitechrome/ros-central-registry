load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

HEADERS = glob(["include/**/*.hpp"])

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

cc_library(
    name = "beacon_common_lib_library",
    srcs = [
        "src/beacon_entity_mapper.cpp",
        "src/beacon_hint_store.cpp",
        "src/beacon_response_builder.cpp",
        "src/beacon_validator.cpp",
    ],
    hdrs = HEADERS,
    copts = ["-std=c++17"],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@nlohmann_json//:singleheader-json",
        "@ros2_medkit_gateway//:gateway_library",
        "@ros2_medkit_msgs//:cc",
    ],
)

cc_shared_library(
    name = "beacon_common_lib",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":beacon_common_lib_library"],
    deps = [":beacon_common_lib_library"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    libraries = [":beacon_common_lib"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@rclcpp//:ament_package",
        "@ros2_medkit_cmake//:ament_package",
        "@ros2_medkit_gateway//:ament_package",
        "@ros2_medkit_msgs//:ament_package",
        "@ros_workspace//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
