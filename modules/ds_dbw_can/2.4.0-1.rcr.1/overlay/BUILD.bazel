load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

HEADERS = glob([
    "include/**/*.hpp",
    "src/**/*.hpp",
])

PACKAGE_DATA = glob([
    "launch/**",
    "scripts/**",
])

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
}

cc_library(
    name = "ds_dbw_can_library",
    srcs = [
        "src/CanSocket.cpp",
        "src/DbwNode.cpp",
    ],
    hdrs = HEADERS,
    copts = ["-std=gnu++20"],
    includes = [
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@can_msgs//:cc",
        "@dataspeed_can_msg_filters//:dataspeed_can_msg_filters_library",
        "@ds_dbw_msgs//:cc",
        "@sensor_msgs//:cc",
        "@std_msgs//:cc",
    ],
)

cc_shared_library(
    name = "ds_dbw_can",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":ds_dbw_can_library"],
    deps = [":ds_dbw_can_library"],
)

### COMPONENTS

rclcpp_components_register_node(
    name = "dbw_node",
    component = ":ds_dbw_can",
    executor = "SingleThreadedExecutor",
    node_name = "dbw_node",
    plugin = "ds_dbw_can::DbwNode",
)

### PACKAGING

ament_package(
    name = "ament_package",
    data = PACKAGE_DATA,
    headers = glob(["include/**/*.hpp"]),
    libraries = [":ds_dbw_can"],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@can_msgs//:ament_package",
        "@dataspeed_can_msg_filters//:ament_package",
        "@dataspeed_can_usb//:ament_package",
        "@ds_dbw_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@ros_workspace//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
