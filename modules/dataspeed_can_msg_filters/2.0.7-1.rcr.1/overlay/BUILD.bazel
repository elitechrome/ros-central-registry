load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

HEADERS = glob(["include/**/*.hpp"])

cc_library(
    name = "dataspeed_can_msg_filters_library",
    hdrs = HEADERS,
    includes = ["include"],
    deps = [
        "@can_msgs//:cc",
        "@rclcpp//:rclcpp_library",
        "@rcutils//:rcutils_library",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@can_msgs//:ament_package",
        "@rclcpp//:ament_package",
        "@rcutils//:ament_package",
        "@ros_workspace//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
